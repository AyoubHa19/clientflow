// ClientFlow's database. After changing this file run `npm run db:migrate`,
// which writes a migration in prisma/migrations and regenerates the client.
//
// Rules every model follows (see README, "Decisions"):
// - Everything a user creates belongs to a workspace (workspaceId), and
//   every query filters by the workspace taken from the session.
// - Ids are UUID v7: random, but in time order, which keeps indexes compact.
// - Calendar dates (start, due) are DATE columns: no time, no time zone.
// - Lengths are capped here too, not only in the forms.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// People and workspaces
// ---------------------------------------------------------------------------

// The fields Better Auth expects. Its own tables are at the end of this file.
model User {
  id            String   @id
  name          String   @db.VarChar(200)
  email         String   @unique @db.VarChar(320)
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships WorkspaceMembership[]
  activities  Activity[]
  sessions    Session[]
  accounts    Account[]

  @@map("users")
}

model Workspace {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(100)
  // An IANA time zone such as "Africa/Casablanca": decides what "today"
  // and "overdue" mean for this workspace.
  timezone  String   @default("UTC") @db.VarChar(64)
  // ISO 4217 code ("MAD") for every amount in the workspace (Stage 15).
  // Changing it relabels amounts; it doesn't convert them.
  currency  String   @default("USD") @db.VarChar(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships WorkspaceMembership[]
  clients     Client[]
  leads       Lead[]
  projects    Project[]
  tasks       Task[]
  activities  Activity[]

  @@map("workspaces")
}

enum MemberRole {
  OWNER
  MEMBER
}

model WorkspaceMembership {
  id          String     @id @default(uuid(7)) @db.Uuid
  userId      String
  workspaceId String     @db.Uuid
  role        MemberRole @default(OWNER)
  createdAt   DateTime   @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // A person is in a workspace once. The index on userId comes from this.
  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("workspace_memberships")
}

// ---------------------------------------------------------------------------
// Clients and leads
// ---------------------------------------------------------------------------

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Client {
  id          String       @id @default(uuid(7)) @db.Uuid
  workspaceId String       @db.Uuid
  name        String       @db.VarChar(200)
  email       String?      @db.VarChar(320)
  phone       String?      @db.VarChar(50)
  company     String?      @db.VarChar(200)
  notes       String?
  status      ClientStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects          Project[]
  convertedFromLead Lead?

  @@index([workspaceId, status, updatedAt])
  @@index([workspaceId, name])
  @@map("clients")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

model Lead {
  id                String     @id @default(uuid(7)) @db.Uuid
  workspaceId       String     @db.Uuid
  contactName       String     @db.VarChar(200)
  company           String?    @db.VarChar(200)
  email             String?    @db.VarChar(320)
  phone             String?    @db.VarChar(50)
  source            String?    @db.VarChar(100)
  status            LeadStatus @default(NEW)
  notes             String?
  // Set when the lead becomes a client. Unique, so one lead can never turn
  // into two clients.
  convertedClientId String?    @unique @db.Uuid
  convertedAt       DateTime?
  // Follow-ups (Stage 14): the last day someone got in touch, and the day to
  // get back to them. With neither recent, an open lead goes cold.
  lastContactedOn   DateTime?  @db.Date
  nextFollowUpOn    DateTime?  @db.Date
  // Money (Stage 15): the expected value, in minor units (cents) of the
  // workspace's currency, and when the lead was last moved to Won.
  value             Int?
  wonAt             DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  convertedClient Client?   @relation(fields: [convertedClientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, updatedAt])
  @@index([workspaceId, contactName])
  @@index([workspaceId, nextFollowUpOn])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// Projects and tasks
// ---------------------------------------------------------------------------

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @db.Uuid
  // Deleting the client keeps the project, without a client.
  clientId    String?       @db.Uuid
  name        String        @db.VarChar(200)
  description String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?     @db.Date
  dueDate     DateTime?     @db.Date
  // What the client pays for it, in minor units (cents) of the workspace's
  // currency (Stage 15).
  fee         Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tasks     Task[]

  @@index([workspaceId, status, updatedAt])
  @@index([workspaceId, dueDate])
  @@index([clientId])
  @@map("projects")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id          String       @id @default(uuid(7)) @db.Uuid
  workspaceId String       @db.Uuid
  // Deleting the project keeps the task, without a project.
  projectId   String?      @db.Uuid
  title       String       @db.VarChar(300)
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @db.Date
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, dueDate])
  @@index([workspaceId, updatedAt])
  @@index([projectId])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Activity log (shown from Stage 9)
// ---------------------------------------------------------------------------

enum ActivityEntity {
  CLIENT
  LEAD
  PROJECT
  TASK
}

enum ActivityAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  COMPLETED
  CONVERTED
  ARCHIVED
  DELETED
  CONTACTED
}

// What happened, kept even after the record itself is deleted: entityId has
// no foreign key on purpose, and `summary` keeps the name it had.
model Activity {
  id          String         @id @default(uuid(7)) @db.Uuid
  workspaceId String         @db.Uuid
  actorId     String?
  entityType  ActivityEntity
  entityId    String         @db.Uuid
  action      ActivityAction
  summary     String         @db.VarChar(300)
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, entityType, entityId])
  @@index([actorId])
  @@map("activities")
}

// ---------------------------------------------------------------------------
// Authentication: written by Better Auth's CLI (`npx auth generate`), only
// the table names changed. Better Auth makes the ids itself.
// ---------------------------------------------------------------------------

// A signed-in browser. The cookie holds `token`; deleting the row signs it out.
model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

// How a user signs in. For email and password, `password` is the scrypt
// hash (never the password itself).
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

// Short-lived codes (email checks, password resets) for later stages.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// Counts recent sign-in and sign-up attempts per IP address and path.
model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rate_limits")
}
