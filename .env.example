# Copy this file to .env.local and fill in the values. .env.local is never
# committed (see .gitignore). This file holds names only, never real secrets.
#
# The database is PostgreSQL on Neon (project "ClientFlow", Frankfurt), one
# branch per use. Get a URL with:
#   npx neonctl connection-string <branch> [--pooled] --database-name neondb --role-name neondb_owner
# and change "sslmode=require" to "sslmode=verify-full".

# The app: dev branch, pooled connection (host ends in "-pooler").
DATABASE_URL=

# Migrations (`npm run db:migrate`): dev branch, direct connection.
DIRECT_DATABASE_URL=

# Database tests (`npm run test:db`): test branch, direct connection.
# Never the same database as above: the tests refuse to run if it is.
TEST_DATABASE_URL=

# Coming in Stage 3: BETTER_AUTH_SECRET, BETTER_AUTH_URL
